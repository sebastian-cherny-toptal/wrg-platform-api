generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum SurveyStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  REQUIRES_PAYMENT
  PAID
  INVOICED
  CANCELLED
  REFUNDED
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model Organization {
  id               String                @id @default(uuid()) @db.Uuid
  legacyId         String?               @unique
  externalId       String?               @unique
  name             String
  slug             String                @unique
  stripeCustomerId String?               @unique
  metadata         Json                  @default("{}")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  users            User[]
  programs         OrganizationProgram[]
  respondents      Respondent[]
  orders           Order[]
  assets           Asset[]
  auditLogs        AuditLog[]
  impersonationGrants ImpersonationGrant[]
}

model Project {
  id          String                @id @default(uuid()) @db.Uuid
  legacyId    String?               @unique
  externalId  String?               @unique
  name        String
  slug        String                @unique
  metadata    Json                  @default("{}")
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  programs    Program[]
  enrollments OrganizationProgram[]
  users       UserProject[]
  orders      Order[]
}

model Program {
  id            String                @id @default(uuid()) @db.Uuid
  legacyId      String?               @unique
  externalId    String?               @unique
  projectId     String                @db.Uuid
  name          String
  year          Int?
  currency      String                @default("USD")
  fees          Json                  @default("{}")
  metadata      Json                  @default("{}")
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizations OrganizationProgram[]
  surveys       Survey[]
  users         UserProgram[]
  orders        Order[]
  impersonationGrants ImpersonationGrant[]

  @@index([projectId])
}

model OrganizationProgram {
  id             String       @id @default(uuid()) @db.Uuid
  legacyId       String?      @unique
  externalId     String?      @unique
  organizationId String       @db.Uuid
  projectId      String       @db.Uuid
  programId      String       @db.Uuid
  dealExternalId String?
  stage          String?
  reportAccess   Json         @default("{}")
  paymentDetails Json         @default("{}")
  metrics        Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  program        Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  users          User[]
  orders         Order[]

  @@unique([organizationId, programId])
  @@index([projectId])
  @@index([dealExternalId])
}

model User {
  id                    String               @id @default(uuid()) @db.Uuid
  legacyId              String?              @unique
  externalId            String?              @unique
  organizationId        String?              @db.Uuid
  organizationProgramId String?              @db.Uuid
  email                 String               @unique
  username              String?              @unique
  fullName              String
  passwordHash          String
  status                UserStatus           @default(INVITED)
  mfaEnabled            Boolean              @default(false)
  metadata              Json                 @default("{}")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  organization          Organization?        @relation(fields: [organizationId], references: [id])
  organizationProgram   OrganizationProgram? @relation(fields: [organizationProgramId], references: [id])
  roles                 UserRole[]
  projects              UserProject[]
  programs              UserProgram[]
  sessions              Session[]
  auditLogs             AuditLog[]
  impersonationGrantsAsActor  ImpersonationGrant[] @relation("ImpersonationActor")
  impersonationGrantsAsTarget ImpersonationGrant[] @relation("ImpersonationTarget")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  legacyId    String?          @unique
  externalId  String?          @unique
  key         String           @unique
  name        String
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  legacyId    String?          @unique
  externalId  String?          @unique
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserProject {
  userId    String  @db.Uuid
  projectId String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
}

model UserProgram {
  userId    String  @db.Uuid
  programId String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@id([userId, programId])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  legacyId         String?   @unique
  externalId       String?   @unique
  userId           String    @db.Uuid
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ImpersonationGrant {
  id             String       @id @default(uuid()) @db.Uuid
  actorUserId    String       @db.Uuid
  targetUserId   String       @db.Uuid
  organizationId String       @db.Uuid
  programId      String       @db.Uuid
  tokenHash      String
  expiresAt      DateTime
  consumedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  actor          User         @relation("ImpersonationActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  target         User         @relation("ImpersonationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program        Program      @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([actorUserId, createdAt])
  @@index([targetUserId, expiresAt])
  @@index([organizationId, programId])
}

model Survey {
  id          String       @id @default(uuid()) @db.Uuid
  legacyId    String?      @unique
  externalId  String?      @unique
  programId   String       @db.Uuid
  title       String
  status      SurveyStatus @default(DRAFT)
  metadata    Json         @default("{}")
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  program     Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  questions   Question[]
  respondents Respondent[]

  @@index([programId])
}

model Question {
  id         String     @id @default(uuid()) @db.Uuid
  legacyId   String?
  externalId String?
  surveyId   String     @db.Uuid
  dataLabel  String
  caption    String
  type       String
  position   Int
  required   Boolean    @default(false)
  metadata   Json       @default("{}")
  survey     Survey     @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  responses  Response[]

  @@unique([surveyId, dataLabel])
  @@index([surveyId, position])
}

model Respondent {
  id             String        @id @default(uuid()) @db.Uuid
  legacyId       String?
  externalId     String?
  surveyId       String        @db.Uuid
  organizationId String?       @db.Uuid
  status         String
  locale         String?
  respondentHash String?
  completedAt    DateTime?
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  survey         Survey        @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id])
  responses      Response[]

  @@unique([surveyId, externalId])
  @@index([organizationId])
}

model Response {
  id           String     @id @default(uuid()) @db.Uuid
  legacyId     String?
  externalId   String?
  respondentId String     @db.Uuid
  questionId   String     @db.Uuid
  value        Json
  score        Decimal?   @db.Decimal(12, 4)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  respondent   Respondent @relation(fields: [respondentId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([respondentId, questionId])
}

model Order {
  id                    String               @id @default(uuid()) @db.Uuid
  legacyId              String?              @unique
  externalId            String?              @unique
  organizationId        String               @db.Uuid
  projectId             String?              @db.Uuid
  programId             String?              @db.Uuid
  organizationProgramId String?              @db.Uuid
  paymentIntentId       String?              @unique
  status                OrderStatus          @default(PENDING)
  currency              String
  amountMinor           Int
  items                 Json
  paymentMethod         String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  organization          Organization         @relation(fields: [organizationId], references: [id])
  project               Project?             @relation(fields: [projectId], references: [id])
  program               Program?             @relation(fields: [programId], references: [id])
  organizationProgram   OrganizationProgram? @relation(fields: [organizationProgramId], references: [id])

  @@index([organizationId, createdAt])
}

model Asset {
  id             String        @id @default(uuid()) @db.Uuid
  legacyId       String?       @unique
  externalId     String?       @unique
  organizationId String?       @db.Uuid
  key            String        @unique
  bucket         String
  contentType    String
  sizeBytes      BigInt
  checksum       String?
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  legacyId       String?
  externalId     String?
  organizationId String?       @db.Uuid
  actorUserId    String?       @db.Uuid
  action         String
  resourceType   String
  resourceId     String?
  correlationId  String?
  ipAddress      String?
  before         Json?
  after          Json?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id])
  actor          User?         @relation(fields: [actorUserId], references: [id])

  @@index([organizationId, createdAt])
  @@index([resourceType, resourceId])
}

model WebhookEvent {
  id             String    @id @default(uuid()) @db.Uuid
  legacyId       String?
  externalId     String
  provider       String
  eventType      String
  payload        Json
  signatureValid Boolean
  processedAt    DateTime?
  error          String?
  receivedAt     DateTime  @default(now())

  @@unique([provider, externalId])
  @@index([provider, receivedAt])
}

model SyncJob {
  id             String    @id @default(uuid()) @db.Uuid
  legacyId       String?
  externalId     String?
  provider       String
  kind           String
  idempotencyKey String    @unique
  status         JobStatus @default(PENDING)
  cursor         String?
  attempts       Int       @default(0)
  input          Json      @default("{}")
  output         Json?
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([provider, kind, status])
}
