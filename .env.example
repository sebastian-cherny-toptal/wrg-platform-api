NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://wrg:wrg@localhost:5432/wrg?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-to-at-least-32-characters
JWT_REFRESH_SECRET=change-me-to-another-32-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Local development only. The API refuses to start with this enabled in production.
BYPASS_LOGIN_AUTH=true
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_WEBHOOK_SECRET=whsec_mock
SENDGRID_KEY=SG.local-mock
SENDGRID_DOMAIN=no-reply@example.test
ZOHO_BASE_URL=http://localhost:3000/mock/zoho
ZOHO_CLIENT_ID=local-mock
ZOHO_CLIENT_SECRET=local-mock
# Set a refresh token in connected environments to call Zoho CRM directly.
# Without it, ZOHO_BASE_URL continues to be treated as the integration proxy.
ZOHO_API_VERSION=v8
ZOHO_WEBHOOK_SECRET=change-me-zoho-webhook
# ZOHO_REFRESH_TOKEN=
# ZOHO_GRANT_TYPE=refresh_token
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# Live ZohoService integration tests skip when these are absent.
# ZOHO_CRM_BASE_URL=https://www.zohoapis.com
# ZOHO_TEST_MODULE=Accounts
# ZOHO_TEST_RECORD_ID=
# ZOHO_TEST_SEARCH_CRITERIA=(Account_Name:equals:Example)
# ZOHO_TEST_COQL=select id from Accounts limit 1
# Write tests additionally require all four variables below.
# ZOHO_TEST_ALLOW_WRITE=false
# ZOHO_TEST_UPDATE_PAYLOAD={"Description":"ZohoService integration test"}
CHECKMARKET_BASE_URL=http://localhost:3000/mock/checkmarket
CHECKMARKET_API_KEY=local-mock
CHECKMARKET_WEBHOOK_SECRET=change-me-checkmarket-webhook
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=wrg-local
OBJECT_STORAGE_ACCESS_KEY=minio
OBJECT_STORAGE_SECRET_KEY=minio123
INTEGRATIONS_MOCK=true
LOG_LEVEL=info
MONGO_SOURCE_URL=mongodb://localhost:27017/wrg-legacy
ETL_ALLOW_WRITE=false

# Optional XLSX-backed program import. Use a secure path or mounted volume that
# contains the original report answers; the committed sanitized fixture is for
# tests only. Published benchmark/benefits workbooks may live beside the ZIP.
# BR_SEED_SOURCE=/app/secure/seed-data/Baton Rouge 24-26.zip
# BR_REPORT_SOURCE=/app/secure/report-data

FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174
CLIENT_URL=http://localhost:5173

# Optional deployment bootstrap. ADMIN_USERNAME must be an email address because
# the administrator login form authenticates by email. If it already exists and
# the configured password differs, its password hash is replaced on startup.
# ADMIN_USERNAME=admin@example.com
# ADMIN_PASSWORD=replace-with-a-strong-password
