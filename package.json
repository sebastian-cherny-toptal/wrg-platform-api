{
  "name": "@wrg/platform-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WRG platform API",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json && cp -R src/native-legacy dist/native-legacy",
    "start": "tsx src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "start:prod": "node --max-old-space-size=3000 dist/main.js",
    "lint": "eslint .",
    "format": "prettier --write \"{src,test,scripts,prisma}/**/*.{ts,json}\"",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "tsx --test test/**/*.spec.ts",
    "test:unit": "tsx --test test/unit/**/*.spec.ts",
    "test:integration": "tsx --test test/integration/**/*.spec.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "client:generate": "openapi-typescript openapi.json -o generated/api.ts",
    "etl:dry-run": "tsx scripts/etl/mongo-to-postgres.ts",
    "reconcile": "tsx scripts/etl/reconcile.ts",
    "native:legacy-check": "node scripts/check-native-legacy.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "find-my-way": "9.7.0",
    "js-yaml": "5.2.2"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^9.3.0",
    "@sendgrid/mail": "^7.6.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "accesscontrol": "^2.2.1",
    "argon2": "^0.45.1",
    "async": "^3.2.6",
    "aws-sdk": "^2.1069.0",
    "axios": "^0.24.0",
    "bottleneck": "^2.19.5",
    "bullmq": "^5.81.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "ejs": "~2.6.1",
    "event-stream": "^4.0.1",
    "exceljs": "^4.3.0",
    "express": "~4.16.1",
    "express-rate-limit": "^5.5.0",
    "fastify": "^5.10.0",
    "form-data": "^4.0.0",
    "find-my-way": "9.7.0",
    "helmet": "^4.6.0",
    "http-errors": "~1.6.3",
    "ioredis": "^5.11.1",
    "JSONStream": "^1.3.5",
    "jsonwebtoken": "^8.5.1",
    "js-yaml": "5.2.2",
    "lodash": "^4.17.21",
    "moment": "^2.29.2",
    "mongodb": "^7.5.0",
    "mongoose": "^6.0.12",
    "morgan": "~1.9.1",
    "multer": "^1.4.4",
    "nestjs-pino": "^4.6.1",
    "node-fetch": "^3.1.0",
    "nodemailer": "^6.7.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "speakeasy": "^2.0.0",
    "stripe": "^22.3.2",
    "tiny-async-pool": "^2.1.0",
    "twilio": "^3.71.3",
    "undici": "^7.29.0",
    "uuid": "^8.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.4",
    "eslint": "^9.32.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.2",
    "prisma": "^7.9.1",
    "tsx": "^4.20.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.38.0"
  }
}
