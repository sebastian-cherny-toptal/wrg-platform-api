{
  "name": "@wrg/platform-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WRG platform API",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json && cp -R src/modules/reports/report-templates dist/modules/reports/",
    "start": "tsx src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "start:prod": "node --max-old-space-size=3000 dist/main.js",
    "lint": "eslint .",
    "format": "prettier --write \"{src,test,scripts,prisma}/**/*.{ts,json}\"",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "tsx --test test/**/*.spec.ts",
    "test:unit": "tsx --test test/unit/**/*.spec.ts",
    "test:integration": "tsx --test test/integration/**/*.spec.ts",
    "test:unit:compatibility1": "tsx --test test/unit/compatibility-reports.spec.ts",
    "test:unit:compatibility2": "tsx --test test/unit/compatibility-heatmap.spec.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "precommit": "npm run check",
    "prepare": "node -e \"const { spawnSync } = require('node:child_process'); const repository = spawnSync('git', ['rev-parse', '--show-toplevel'], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }); if (repository.status === 0 && repository.stdout.trim()) { const configured = spawnSync('git', ['config', 'core.hooksPath', '.githooks'], { cwd: repository.stdout.trim(), stdio: 'inherit' }); if (configured.error) throw configured.error; if (configured.status !== 0) process.exit(configured.status ?? 1); }\"",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma generate && prisma migrate deploy",
    "db:deploy:production": "prisma migrate deploy && if [ -n \"$BR_SEED_SOURCE\" ]; then node dist/cli/seed-baton-rouge.js; fi",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:baton-rouge": "tsx src/cli/seed-baton-rouge.ts",
    "db:seed:baton-rouge:compiled": "node dist/cli/seed-baton-rouge.js",
    "fixture:baton-rouge": "tsx src/cli/prepare-baton-rouge-test-fixture.ts",
    "db:reset": "prisma migrate reset --force",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "client:generate": "openapi-typescript openapi.json -o generated/api.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "brace-expansion@^1": "1.1.18",
    "brace-expansion@^2": "2.1.4",
    "brace-expansion@^5": "5.0.9",
    "deepmerge-ts@^7": "8.0.0",
    "fast-uri@^3": "3.1.6",
    "js-yaml": "5.2.2",
    "mysql2": "3.24.1",
    "uuid@^8": "11.1.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-fastify": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sendgrid/mail": "^8.1.6",
    "adm-zip": "^0.6.1",
    "argon2": "^0.45.1",
    "bullmq": "^5.81.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.3.0",
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^5.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "speakeasy": "^2.0.0",
    "stripe": "^22.3.2",
    "undici": "^7.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.1.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.4",
    "eslint": "^9.32.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.38.0"
  }
}
