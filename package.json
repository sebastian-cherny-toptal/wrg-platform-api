{
  "name": "@wrg/platform-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WRG platform API",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json && cp -R src/modules/reports/report-templates dist/modules/reports/",
    "start": "tsx src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "start:prod": "node --max-old-space-size=3000 dist/main.js",
    "lint": "eslint .",
    "format": "prettier --write \"{src,test,scripts,prisma}/**/*.{ts,json}\"",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "tsx --test test/**/*.spec.ts",
    "test:unit": "tsx --test test/unit/**/*.spec.ts",
    "test:integration": "tsx --test test/integration/**/*.spec.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma generate && prisma migrate deploy",
    "db:deploy:production": "prisma migrate deploy && node dist/cli/ensure-baton-user.js",
    "db:ensure:baton-user": "tsx src/cli/ensure-baton-user.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:baton-rouge": "tsx src/cli/seed-baton-rouge.ts",
    "db:seed:baton-rouge:compiled": "node dist/cli/seed-baton-rouge.js",
    "fixture:baton-rouge": "tsx src/cli/prepare-baton-rouge-test-fixture.ts",
    "db:reset": "prisma migrate reset --force",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "client:generate": "openapi-typescript openapi.json -o generated/api.ts",
    "etl:dry-run": "tsx scripts/etl/mongo-to-postgres.ts",
    "reconcile": "tsx scripts/etl/reconcile.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "find-my-way": "9.7.0",
    "js-yaml": "5.2.2"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@sendgrid/mail": "^7.6.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "adm-zip": "^0.6.0",
    "argon2": "^0.45.1",
    "aws-sdk": "^2.1069.0",
    "bullmq": "^5.81.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.3.0",
    "fastify": "^5.10.0",
    "find-my-way": "9.7.0",
    "ioredis": "^5.11.1",
    "mongodb": "^7.5.0",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "prisma": "^7.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "speakeasy": "^2.0.0",
    "stripe": "^22.3.2",
    "undici": "^7.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.1.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.4",
    "eslint": "^9.32.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.38.0"
  }
}
